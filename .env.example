# ── Supabase (required) ───────────────────────────────────────────────────────
# Values are in your Supabase project under Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — bypasses RLS (used by the cron route only).
# NEVER expose in client code or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── AWS S3 (required for file attachments) ────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_S3_BUCKET_NAME=<your-bucket-name>

# ── Email reminders (required for due-date reminders via Resend) ──────────────
RESEND_API_KEY=re_<your-resend-key>
# Must be a verified sender domain in Resend.
REMINDER_FROM_EMAIL=reminders@yourdomain.com

# ── Cron authentication ────────────────────────────────────────────────────────
# Random secret used to authenticate the Vercel Cron request.
# Generate with: openssl rand -hex 32
REMINDER_CRON_SECRET=<random-secret>

# ── Attachment scan callback (optional) ───────────────────────────────────────
# Bearer secret that an external scanner must include in the Authorization header
# when POSTing to /api/attachments/scan-callback.
# Only required when an external scanner (e.g. AWS Lambda) is configured.
# Generate with: openssl rand -hex 32
# ATTACHMENT_SCAN_CALLBACK_SECRET=<random-secret>

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
# SENTRY_AUTH_TOKEN=<token-for-sourcemap-upload>
# SENTRY_ORG=<your-sentry-org-slug>
# SENTRY_PROJECT=<your-sentry-project-slug>

# ── Upstash Redis (optional) ──────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>
